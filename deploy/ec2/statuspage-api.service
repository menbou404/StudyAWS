[Unit]
Description=Statuspage API
# DB の配置先に依存させず、同一サーバーの PostgreSQL（Phase 2）の起動順序・起動要求は
# local-postgres.conf で追加する。RDS（Phase 3 以降）ではドロップインは不要。
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
# Docker の appuser と同様、侵害時の影響を抑えるため root では実行しない。
User=statuspage
Group=statuspage
WorkingDirectory=/opt/statuspage/app
# Compose の environment に相当。秘密情報をリポジトリから分離する。
EnvironmentFile=/etc/statuspage.env
# Compose の ports に相当する入口は nginx に任せ、API への直接接続を防ぐ。
ExecStart=/opt/statuspage/app/.venv/bin/uvicorn statuspage.api:app --host 127.0.0.1 --port 8000
# Compose の restart: unless-stopped に相当する復旧設定だが、ここでは異常終了時だけ再起動する。
Restart=on-failure
RestartSec=5
# Compose の停止と同様、SIGTERM 後に猶予を設け、期限を超えたら SIGKILL する。
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
