[Unit]
Description=Statuspage monitoring worker
# DB の配置先に依存させず、同一サーバーの PostgreSQL（Phase 2）の起動順序・起動要求は
# local-postgres.conf で追加する。RDS（Phase 3 以降）ではドロップインは不要。
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
# Docker の appuser と同様、侵害時の影響を抑えるため root では実行しない。
User=statuspage
Group=statuspage
WorkingDirectory=/opt/statuspage/app
# Compose の environment に相当。秘密情報をリポジトリから分離する。
EnvironmentFile=/etc/statuspage.env
ExecStart=/opt/statuspage/app/.venv/bin/python -m statuspage.worker
# Compose の restart: unless-stopped に相当する復旧設定だが、ここでは異常終了時だけ再起動する。
Restart=on-failure
RestartSec=5
# Compose の停止と同様、SIGTERM → 猶予 → SIGKILL の順で停止する。
# 旧版は SIGKILL されたが、現版は SIGTERM で今の回を終えるため通常は期限に達しない。
# ただし監視対象が多く、1回の実行が30秒を超える場合は強制終了され得る。
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
