# サーバー上の /etc/statuspage.env にコピーし、CHANGE_ME を実際のパスワードに置き換える。
# 秘密情報を公開しないため、実ファイルは決してコミットしない。
# root 所有・モード600にする。systemd は root 権限で読み込んでからアプリに渡すので、アプリのユーザーに読む権限は要らない。
# Phase 3 では DATABASE_URL を RDS に向け、パスワードを Secrets Manager に移す。
DATABASE_URL=postgresql+psycopg://statuspage:CHANGE_ME@127.0.0.1:5432/statuspage
CHECK_INTERVAL_SECONDS=60
CHECK_TIMEOUT_SECONDS=10
RETENTION_DAYS=7
